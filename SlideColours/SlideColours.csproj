<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Screen capture calls D3D11/DXGI through raw COM vtables (see DesktopDuplicator.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SlideColours</AssemblyName>
    <RootNamespace>SlideColours</RootNamespace>
    <Version>1.3.0</Version>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- WASAPI capture for the music-reactive breathe mode (see AudioLevelSource.cs). The Wasapi
         package is the lean slice of NAudio: device enumeration and capture, nothing else. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="appicon.ico" />
  </ItemGroup>

</Project>
