<Window x:Class="SlideColours.SceneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slide Colours — Scenes"
        Width="900" Height="600" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= scene list ================= -->
        <GroupBox Grid.Row="0" Grid.Column="0" Header="Scenes" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" x:Name="SceneList" MinHeight="120"
                         SelectionChanged="SceneList_SelectionChanged"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddSceneButton" Content="Add scene" Width="86" Padding="0,4"
                            Click="AddScene_Click"
                            ToolTip="Creates a scene from what the lights are doing right now"/>
                    <Button x:Name="RemoveSceneButton" Content="Remove" Width="80" Padding="0,4" Margin="8,0,0,0"
                            Click="RemoveScene_Click"/>
                </StackPanel>

                <Grid Grid.Row="2" x:Name="SceneDetail" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Name:"/>
                    <TextBox Grid.Column="1" x:Name="SceneNameBox" Margin="0,2"
                             VerticalContentAlignment="Center" TextChanged="SceneName_Changed"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ================= what the scene sets ================= -->
        <GroupBox Grid.Row="0" Grid.Column="2" Header="What this scene sets" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GroupRows"/>
                </ScrollViewer>

                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Left" x:Name="CaptureButton" Content="Set from current lights"
                            Padding="10,5" Click="Capture_Click"
                            ToolTip="Replaces this scene with whatever the stage is doing right now"/>
                    <TextBlock x:Name="SceneHintText" Margin="10,0,0,0" Foreground="Gray"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="2,12,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="Scenes are saved looks. Recalling one from the main window sets every group at once. Changing a colour during a service never edits a scene — come back here and use &quot;Set from current lights&quot; to update it."/>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cancel" Width="80" Padding="0,5" Margin="16,0,8,0" IsCancel="True"/>
                <Button Content="Save" Width="80" Padding="0,5" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
            <TextBlock/>
        </DockPanel>

    </Grid>
</Window>
