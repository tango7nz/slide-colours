<Window x:Class="SlideColours.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:System.Windows;assembly=PresentationFramework"
        Title="Slide Colours — Settings"
        Width="840" SizeToContent="Height" ResizeMode="NoResize"
        MaxHeight="{x:Static w:SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Left column: where the colour comes from and where it goes -->
        <StackPanel Grid.Row="0" Grid.Column="0">

            <GroupBox Header="ProPresenter" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Host:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostBox" Margin="0,2" VerticalContentAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Port:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" Margin="0,2" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="4,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="In ProPresenter: Preferences → Network → Enable Network. Use the port shown there."/>
                </Grid>
            </GroupBox>

            <GroupBox Header="DMX output" Padding="8" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Protocol:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ProtocolBox" Margin="0,2"
                              SelectionChanged="ProtocolBox_SelectionChanged">
                        <ComboBoxItem Tag="artnet" Content="Art-Net (network)"/>
                        <ComboBoxItem Tag="sacn" Content="sACN / E1.31 (network)"/>
                        <ComboBoxItem Tag="enttec" Content="Enttec DMX USB Pro (serial)"/>
                    </ComboBox>

                    <Label Grid.Row="1" Grid.Column="0" Content="Target IP:" x:Name="TargetIpLabel"/>
                    <DockPanel Grid.Row="1" Grid.Column="1" x:Name="TargetIpPanel">
                        <Button DockPanel.Dock="Right" x:Name="ScanButton" Content="Scan…" Width="64" Margin="6,2,0,2"
                                Click="Scan_Click"
                                ToolTip="Search the network for DMX nodes (Art-Net discovery)"/>
                        <TextBox x:Name="TargetIpBox" Margin="0,2" VerticalContentAlignment="Center"
                                 ToolTip="Leave blank to broadcast (Art-Net) or multicast (sACN)"/>
                    </DockPanel>

                    <Label Grid.Row="2" Grid.Column="0" Content="Universe:" x:Name="UniverseLabel"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="UniverseBox" Margin="0,2" VerticalContentAlignment="Center"
                             ToolTip="Art-Net universes start at 0, sACN universes start at 1"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="COM port:" x:Name="ComPortLabel"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ComPortBox" Margin="0,2" IsEditable="True"/>

                </Grid>
            </GroupBox>

            <!-- The rig is its own thing, not a property of the DMX endpoint. Giving the two
                 editors a full-width row apiece stops them being crushed against the summary. -->
            <GroupBox Header="Lights, groups &amp; scenes" Padding="8" Margin="0,10,0,0">
                <StackPanel>
                    <UniformGrid Columns="2">
                        <Button x:Name="RigButton" Content="Lights &amp; groups…"
                                Padding="10,5" Margin="0,0,4,0" Click="Rig_Click"
                                ToolTip="Name each light, patch its channel, and build the groups that drive them"/>
                        <Button x:Name="ScenesButton" Content="Scenes…"
                                Padding="10,5" Margin="4,0,0,0" Click="Scenes_Click"
                                ToolTip="Save named looks that set every group at once"/>
                    </UniformGrid>

                    <TextBlock x:Name="RigSummaryText" Foreground="Gray" Margin="4,8,0,0" TextWrapping="Wrap"/>

                    <TextBlock Margin="4,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="Every group runs at once with its own source, so one set of lights can follow the screen while another holds a colour. A scene saves what they're all doing as a look you can recall in one click."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Screen capture (Follow screen)" Padding="8" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Display:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CaptureDisplayBox" Margin="0,2"
                              ToolTip="The screen to sample. Pick the one showing the audience/main output."/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Smoothing (ms):"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="SmoothingBox" Margin="0,2" VerticalContentAlignment="Center"
                             ToolTip="How quickly the lights chase the picture. Higher is calmer, lower is snappier."/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Sample rate:"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CaptureFpsBox" Margin="0,2"
                              ToolTip="Frames per second sampled from the display">
                        <ComboBoxItem Tag="15" Content="15 per second (lightest)"/>
                        <ComboBoxItem Tag="30" Content="30 per second (recommended)"/>
                        <ComboBoxItem Tag="60" Content="60 per second (smoothest)"/>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="4,6,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="Samples the screen itself, so animated and video backgrounds drive the lights. The display must be connected and awake — it won't capture a projector that's switched off."/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Remote control (Stream Deck)" Padding="8" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" x:Name="RemoteEnabledCheck" Margin="4,2,0,4"
                              Checked="RemoteEnabled_Changed" Unchecked="RemoteEnabled_Changed">
                        <TextBlock Text="Let Bitfocus Companion / Stream Deck recall scenes" TextWrapping="Wrap"/>
                    </CheckBox>

                    <Label Grid.Row="1" Grid.Column="0" Content="Port:" x:Name="RemotePortLabel"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="RemotePortBox" Margin="0,2"
                             VerticalContentAlignment="Center"
                             ToolTip="The port Companion connects to. 7373 unless something else is using it."/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Access key:" x:Name="RemoteKeyLabel"/>
                    <DockPanel Grid.Row="2" Grid.Column="1" x:Name="RemoteKeyPanel" Margin="0,2">
                        <Button DockPanel.Dock="Right" x:Name="RemoteKeyButton" Content="New" Width="52"
                                Margin="6,0,0,0" Click="RemoteKey_Click"
                                ToolTip="Generate a new key. Companion will need the new URL."/>
                        <TextBox x:Name="RemoteKeyBox" VerticalContentAlignment="Center"
                                 ToolTip="Required as ?key=… on every request. Clear it to allow anyone on the network to control the lights."/>
                    </DockPanel>

                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" x:Name="RemoteHintText" Margin="4,6,0,0"
                               Foreground="Gray" TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>

        </StackPanel>

        <!-- Right column: how the colour behaves, plus app-level settings -->
        <StackPanel Grid.Row="0" Grid.Column="2">

            <GroupBox Header="Colour behaviour" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Fade time (ms):"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FadeBox" Margin="0,2" VerticalContentAlignment="Center"
                             ToolTip="How long a slide change takes to fade. Follow screen uses its own smoothing setting instead."/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Brightness:"/>
                    <Slider Grid.Row="1" Grid.Column="1" x:Name="BrightnessSlider" Minimum="0" Maximum="100"
                            VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="BrightnessValue" VerticalAlignment="Center" TextAlignment="Right"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Saturation boost:"/>
                    <Slider Grid.Row="2" Grid.Column="1" x:Name="SaturationSlider" Minimum="0" Maximum="100"
                            VerticalAlignment="Center" ValueChanged="Slider_ValueChanged"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SaturationValue" VerticalAlignment="Center" TextAlignment="Right"/>

                    <!-- content as a wrapping TextBlock: the caption is wider than the column -->
                    <CheckBox Grid.Row="3" Grid.ColumnSpan="3" x:Name="FullBrightnessCheck" Margin="4,8,0,2">
                        <TextBlock Text="Always output colours at full intensity (recommended for stage wash)"
                                   TextWrapping="Wrap"/>
                    </CheckBox>

                    <Label Grid.Row="4" Grid.Column="0" Content="No colour found:"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FallbackBox" Margin="0,2"
                              ToolTip="What to do when the slide or screen is black &amp; white with no dominant colour">
                        <ComboBoxItem Tag="keep" Content="Keep the last colour"/>
                        <ComboBoxItem Tag="off" Content="Fade lights to off"/>
                        <ComboBoxItem Tag="white" Content="Fade to warm white"/>
                    </ComboBox>
                </Grid>
            </GroupBox>

            <GroupBox Header="Updates" Padding="8" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="VersionText" Foreground="Gray" Margin="4,0,0,0"/>
                    <CheckBox x:Name="AutoCheckUpdatesCheck" Margin="4,8,0,0"
                              Content="Automatically check for updates on startup"/>
                    <TextBlock x:Name="UpdateStatusText" Margin="4,6,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="ReleaseNotesText" Margin="4,4,0,0" Visibility="Collapsed">
                        <Hyperlink x:Name="ReleaseNotesLink" RequestNavigate="Hyperlink_RequestNavigate">
                            View release notes
                        </Hyperlink>
                    </TextBlock>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Left" x:Name="CheckUpdateButton" Content="Check for updates"
                                Padding="10,5" Click="CheckUpdate_Click"/>
                        <Button HorizontalAlignment="Right" x:Name="InstallUpdateButton" Content="Install update"
                                Padding="10,5" Visibility="Collapsed" Click="InstallUpdate_Click"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Startup" Padding="8" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" x:Name="StartEnabledCheck" Margin="4,2,0,4"
                              Content="Turn lighting control on when the app starts"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Selected group:"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="StartupGroupBox" Margin="0,2"
                              ToolTip="Which group the main window's controls act on when the app opens. Every group still runs on its own source either way."/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Recall scene:"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="StartupSceneBox" Margin="0,2"
                              ToolTip="A scene to apply on launch, so every service opens on the same look regardless of how the last one ended"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Settings file" Padding="8" Margin="0,10,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" x:Name="SaveToFileButton" Content="Save to file…"
                                Padding="10,5" Click="SaveToFile_Click"
                                ToolTip="Write these settings, lights and groups to a .json file you can keep or copy to another PC"/>
                        <Button HorizontalAlignment="Right" x:Name="LoadFromFileButton" Content="Load from file…"
                                Padding="10,5" Click="LoadFromFile_Click"
                                ToolTip="Replace all current settings with a previously saved .json file"/>
                    </DockPanel>
                    <TextBlock x:Name="SettingsPathText" Margin="4,8,0,0" Foreground="Gray"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </GroupBox>

            <TextBlock Margin="4,14,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap">
                Free &amp; open-source under the MIT license.<LineBreak/>
                <Hyperlink NavigateUri="https://github.com/tango7nz/slide-colours"
                           RequestNavigate="Hyperlink_RequestNavigate">Help and Feedback</Hyperlink>
            </TextBlock>

        </StackPanel>

        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" x:Name="TestButton" Content="Test lights" Width="100" Padding="0,5"
                    Click="Test_Click"
                    ToolTip="Saves these settings, then lights each fixture in turn — red, green, blue, white — so you can check which light is which and that its channels are in order"/>
            <TextBlock DockPanel.Dock="Left" x:Name="TestStatusText" Margin="10,0,0,0" Foreground="Gray"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Padding="0,5" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Save" Width="80" Padding="0,5" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>

    </Grid>
    </ScrollViewer>
</Window>
