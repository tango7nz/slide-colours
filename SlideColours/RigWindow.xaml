<Window x:Class="SlideColours.RigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slide Colours — Lights &amp; groups"
        Width="880" Height="600" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Lights ================= -->
        <GroupBox Grid.Row="0" Grid.Column="0" Header="Lights" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" x:Name="FixtureList" MinHeight="120"
                         SelectionChanged="FixtureList_SelectionChanged"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddFixtureButton" Content="Add light" Width="90" Padding="0,4"
                            Click="AddFixture_Click"/>
                    <Button x:Name="RemoveFixtureButton" Content="Remove" Width="90" Padding="0,4" Margin="8,0,0,0"
                            Click="RemoveFixture_Click"/>
                    <Button x:Name="FlashFixtureButton" Content="Flash" Width="70" Padding="0,4" Margin="8,0,0,0"
                            Click="FlashFixture_Click"
                            ToolTip="Light just this fixture — red, green, blue, white — using the channel typed above, even if you haven't saved yet. Every other light is held dark."/>
                </StackPanel>

                <Grid Grid.Row="2" x:Name="FixtureDetail" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Name:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="FixtureNameBox" Margin="0,2"
                             VerticalContentAlignment="Center" TextChanged="FixtureField_Changed"
                             ToolTip="What this light is called on stage, e.g. Left Front"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Start channel:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="FixtureChannelBox" Margin="0,2"
                             VerticalContentAlignment="Center" TextChanged="FixtureField_Changed"
                             ToolTip="First DMX channel of this fixture (1–512). Red, green and blue follow in order."/>

                    <CheckBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="FixtureDimmerCheck" Margin="4,8,0,2"
                              Checked="FixtureField_Changed" Unchecked="FixtureField_Changed"
                              Content="Has a master dimmer channel before red/green/blue"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ================= Groups ================= -->
        <GroupBox Grid.Row="0" Grid.Column="2" Header="Groups" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" x:Name="GroupList" MinHeight="120"
                         SelectionChanged="GroupList_SelectionChanged"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="AddGroupButton" Content="Add group" Width="90" Padding="0,4"
                            Click="AddGroup_Click"/>
                    <Button x:Name="RemoveGroupButton" Content="Remove" Width="90" Padding="0,4" Margin="8,0,0,0"
                            Click="RemoveGroup_Click"/>
                </StackPanel>

                <Grid Grid.Row="2" x:Name="GroupDetail" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Name:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="GroupNameBox" Margin="0,2"
                             VerticalContentAlignment="Center" TextChanged="GroupField_Changed"
                             ToolTip="What this group is called, e.g. Front Wash"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Colour from:"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="GroupSourceBox" Margin="0,2"
                              SelectionChanged="GroupField_Changed"
                              ToolTip="Every group runs at once, each with its own source">
                        <ComboBoxItem Tag="slide" Content="Follow slide"/>
                        <ComboBoxItem Tag="screen" Content="Follow screen"/>
                        <ComboBoxItem Tag="manual" Content="Manual colour (set from the main window)"/>
                        <ComboBoxItem Tag="off" Content="Off — hold these lights dark"/>
                    </ComboBox>

                    <Label Grid.Row="2" Grid.Column="0" Content="With the music:"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="GroupPulseBox" Margin="0,2"
                              SelectionChanged="GroupField_Changed"
                              ToolTip="Breathe rides this group's brightness on the bass. The colour still comes from the source above.">
                        <ComboBoxItem Tag="off" Content="Steady — ignore the music"/>
                        <ComboBoxItem Tag="breathe" Content="Breathe with the bass"/>
                    </ComboBox>

                    <Label Grid.Row="3" Grid.Column="0" Content="Depth:" x:Name="GroupDepthLabel"/>
                    <Slider Grid.Row="3" Grid.Column="1" x:Name="GroupDepthSlider" Minimum="0" Maximum="90"
                            VerticalAlignment="Center" ValueChanged="GroupDepth_Changed"
                            ToolTip="How far the lights drop between beats. Higher is more dramatic; keep it modest so quiet passages don't look like a fault."/>
                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="GroupDepthValue" VerticalAlignment="Center"
                               TextAlignment="Right"/>

                    <Label Grid.Row="4" Grid.Column="0" Content="Lights in group:" VerticalAlignment="Top"/>
                    <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="#FFACACAC"
                            BorderThickness="1" Margin="0,4,0,0">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MembershipPanel" Margin="6,4"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="5" Grid.ColumnSpan="3" x:Name="GroupHintText" Margin="4,6,0,0"
                               Foreground="Gray" TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="WarningText" Margin="2,12,0,0"
                   Foreground="#FFB05A00" TextWrapping="Wrap" Visibility="Collapsed"/>

        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <!-- buttons dock first so the hint gives up width to them, not the other way round -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cancel" Width="80" Padding="0,5" Margin="16,0,8,0" IsCancel="True"/>
                <Button Content="Save" Width="80" Padding="0,5" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap"
                       Text="Define each light once, then group them. Groups run simultaneously, so one can follow the screen while another holds a colour."/>
        </DockPanel>

    </Grid>
</Window>
